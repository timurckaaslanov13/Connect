# Generate fresh values: python scripts/init_env.py
# Existing PostgreSQL volumes require their CURRENT passwords.
# Generated hex passwords are URL-safe; custom passwords in DATABASE_URL need URL encoding.
JWT_SECRET_KEY=
INTERNAL_API_KEY=
AUTH_DB_PASSWORD=
USER_DB_PASSWORD=
CHAT_DB_PASSWORD=
MESSAGE_DB_PASSWORD=
AUTH_PORT=8000
USER_PORT=8001
CHAT_PORT=8002
MESSAGE_PORT=8003
AUTH_DB_PORT=5432
USER_DB_PORT=5433
CHAT_DB_PORT=5434
MESSAGE_DB_PORT=5435
